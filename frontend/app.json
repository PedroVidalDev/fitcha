{
    "expo": {
        "name": "Fitcha",
        "slug": "fitcha",
        "version": "1.0.6",
        "runtimeVersion": {
            "policy": "appVersion"
        },
        "updates": {
            "url": "https://u.expo.dev/f19f2656-d5ab-4268-a6ac-f11c2f7e44b2",
            "checkAutomatically": "NEVER"
        },
        "orientation": "portrait",
        "icon": "./src/assets/images/icon.png",
        "scheme": "fitcha",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "package": "com.pedrovidaldev.fitcha",
            "softwareKeyboardLayoutMode": "pan",
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "adaptiveIcon": {
                "foregroundImage": "./src/assets/images/icon.png",
                "backgroundColor": "#F06B2A"
            }
        },
        "web": {
            "output": "static"
        },
        "plugins": [
            [
                "expo-splash-screen",
                {
                    "image": "./src/assets/images/splash-icon.png",
                    "imageWidth": 160,
                    "resizeMode": "contain",
                    "backgroundColor": "#F06B2A"
                }
            ],
            [
                "expo-notifications",
                {
                    "icon": "./src/assets/images/icon.png",
                    "color": "#F06B2A",
                    "defaultChannel": "treino"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "f19f2656-d5ab-4268-a6ac-f11c2f7e44b2"
            }
        }
    }
}
